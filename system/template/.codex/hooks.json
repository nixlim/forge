{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Task completed\" with title \"Codex — {{FORGE_PROJECT_NAME}}\"' >/dev/null 2>&1 || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .opencode/scripts/aggregate-telemetry.sh .tmp/decisions --csv .tmp/telemetry-latest.csv >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
